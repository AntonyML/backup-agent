# Configuración de pruebas para femucaribe-backup-agent
# NOTA: Usar únicamente valores ficticios o de entornos de desarrollo aislados.
# NUNCA utilizar datos o credenciales de producción.

# Parámetros del entorno de producción protegido (defaults de FEMUCARIBE)
TEST_PRODUCTION_SQLSERVER=Caproba01\vbadilla
TEST_PRODUCTION_DATABASE=CONTABILIDAD
TEST_PRODUCTION_BACKUP_PATH=C:\Backups\

# Parámetros del entorno de pruebas
TEST_DATABASE_DRIVER=sqlite
TEST_DATABASE_PATH=
TEST_BACKUP_ROOT=C:\BackupsTest\

# Parámetros para SQL Server aislado (Docker / Laboratorio)
TEST_SQLSERVER_HOST=localhost
TEST_SQLSERVER_PORT=14333
TEST_SQLSERVER_DATABASE=CONTABILIDAD_TEST
TEST_SQLSERVER_USER=sa
TEST_SQLSERVER_PASSWORD=TestPassw0rd!123

# Conservar artefactos tras fallos en tests
KEEP_TEST_ARTIFACTS=false
